{
  "id": "tagandtally",
  "title": "Tag & Tally",
  "description": "An unofficial Foundry VTT game system for the Tag & Tally tabletop RPG (https://tagandtally.quest). Tags, tallies, wounds, spells, quests, and the full Sparks procedural generators.",
  "version": "0.9.1",
  "authors": [
    {
      "name": "Julio Monteiro",
      "url": "https://github.com/julioholon"
    }
  ],
  "url": "https://github.com/julioholon/tagandtally-foundryvtt",
  "manifest": "https://github.com/julioholon/tagandtally-foundryvtt/releases/latest/download/system.json",
  "download": "https://github.com/julioholon/tagandtally-foundryvtt/releases/latest/download/tagandtally.zip",
  "license": "LICENSE.md",
  "readme": "README.md",
  "changelog": "https://github.com/julioholon/tagandtally-foundryvtt/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/julioholon/tagandtally-foundryvtt/issues",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "tagandtally.mjs"
  ],
  "styles": [
    "styles/tagandtally.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "pt-BR",
      "name": "Portugu\u00eas (Brasil)",
      "path": "lang/pt-BR.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "biography",
          "notes"
        ]
      },
      "npc": {
        "htmlFields": [
          "biography",
          "notes"
        ]
      },
      "faction": {
        "htmlFields": [
          "biography",
          "notes"
        ]
      }
    },
    "Item": {
      "tag": {
        "htmlFields": [
          "description"
        ]
      },
      "gear": {
        "htmlFields": [
          "description"
        ]
      },
      "spell": {
        "htmlFields": [
          "description"
        ]
      },
      "quest": {
        "htmlFields": [
          "description"
        ]
      },
      "wound": {
        "htmlFields": [
          "description"
        ]
      }
    }
  },
  "primaryTokenAttribute": "wounds.vitality",
  "secondaryTokenAttribute": "wealth.value",
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "socket": true,
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
  "media": [
    {
      "type": "cover",
      "url": "https://raw.githubusercontent.com/julioholon/tagandtally-foundryvtt/main/assets/cover.png",
      "caption": "Tag & Tally for Foundry VTT"
    },
    {
      "type": "icon",
      "url": "https://raw.githubusercontent.com/julioholon/tagandtally-foundryvtt/main/assets/icon.png"
    }
  ]
}
