<header class="tt-header">
  <img class="tt-portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" />
  <div class="tt-header-main">
    <div class="tt-name-row">
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'TAGANDTALLY.Name'}}" />
      {{#if augurLinked}}<button type="button" class="tt-icon-btn" data-action="importAugur" title="{{localize 'TAGANDTALLY.Augur.Import'}}"><i class="fa-solid fa-file-import"></i></button>{{/if}}
      {{#if owner}}<button type="button" class="tt-icon-btn" data-action="randomize" title="{{localize 'TAGANDTALLY.Builder.Title'}}"><i class="fa-solid fa-wand-magic-sparkles"></i></button>{{/if}}
      <button type="button" class="tt-roll-btn" data-action="rollTask" title="{{localize 'TAGANDTALLY.Roll.Task'}}"><i class="fa-solid fa-dice-d20"></i> {{localize "TAGANDTALLY.Roll.Roll"}}</button>
    </div>
    <div class="tt-sentence-row">
      <span class="tt-sentence-word">{{localize "TAGANDTALLY.Sentence.IsA"}}</span>
      <span class="tt-slot"><input type="text" name="system.sentence.descriptor" value="{{system.sentence.descriptor}}" placeholder="{{localize 'TAGANDTALLY.TagType.Descriptor'}}" class="tt-tag-input" /><a data-action="rerollSlot" data-slot="descriptor" title="{{localize 'TAGANDTALLY.Builder.Reroll'}}"><i class="fa-solid fa-dice"></i></a></span>
      <span class="tt-slot"><input type="text" name="system.sentence.species" value="{{system.sentence.species}}" placeholder="{{localize 'TAGANDTALLY.TagType.Species'}}" class="tt-tag-input" /><a data-action="rerollSlot" data-slot="species" title="{{localize 'TAGANDTALLY.Builder.Reroll'}}"><i class="fa-solid fa-dice"></i></a></span>
      <span class="tt-slot"><input type="text" name="system.sentence.type" value="{{system.sentence.type}}" placeholder="{{localize 'TAGANDTALLY.TagType.Type'}}" class="tt-tag-input" /><a data-action="rerollSlot" data-slot="type" title="{{localize 'TAGANDTALLY.Builder.Reroll'}}"><i class="fa-solid fa-dice"></i></a></span>
      <span class="tt-sentence-word">{{localize "TAGANDTALLY.Sentence.Who"}}</span>
      <span class="tt-slot"><input type="text" name="system.sentence.specialty" value="{{system.sentence.specialty}}" placeholder="{{localize 'TAGANDTALLY.TagType.Specialty'}}" class="tt-tag-input wide" /><a data-action="rerollSlot" data-slot="specialty" title="{{localize 'TAGANDTALLY.Builder.Reroll'}}"><i class="fa-solid fa-dice"></i></a></span>
      <a data-action="buildSentence" title="{{localize 'TAGANDTALLY.Sentence.BuildFromTags'}}"><i class="fa-solid fa-wand-magic"></i></a>
      <a data-action="sentenceToChat" title="{{localize 'TAGANDTALLY.Sentence.ToChat'}}"><i class="fa-solid fa-comment"></i></a>
    </div>
    <div class="tt-status-row">
      <div class="tt-stat tt-severity sev-{{wounds.severity}}" title="{{localize 'TAGANDTALLY.Wound.Severity'}}">
        <i class="fa-solid fa-heart-crack"></i> {{severityLabel}}
        {{#if wounds.worst}}<span class="tt-worst">{{wounds.worst.name}}{{#if wounds.worst.hinders}}: {{wounds.worst.hinders}}{{/if}}</span>{{/if}}
      </div>
      <div class="tt-stat" title="{{localize 'TAGANDTALLY.Wealth.Wealth'}}">
        <a data-action="wealthStep" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
        <i class="fa-solid fa-coins"></i> {{system.wealth.value}} <small>{{wealthLabel}}</small>
        <a data-action="wealthStep" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        {{#if system.wealth.inDebt}}<span class="tt-tag warn">{{localize "TAGANDTALLY.Wealth.InDebt"}}</span>{{/if}}
      </div>
      {{#if coinsMode}}<div class="tt-stat" title="{{localize 'TAGANDTALLY.Coins.Hint'}}">
        <i class="fa-solid fa-coins"></i> <input type="number" name="system.wealth.coins" value="{{system.wealth.coins}}" min="0" class="tt-small-num" /> <small>/ {{system.wealth.climbCost}}</small>
        {{#if system.wealth.canClimb}}<a data-action="climbWealth" title="{{localize 'TAGANDTALLY.Coins.Climb'}}"><i class="fa-solid fa-arrow-up"></i></a>{{/if}}
        {{#if (tt-gt system.wealth.value 0)}}<a data-action="cashOut" title="{{localize 'TAGANDTALLY.Coins.CashOut'}}"><i class="fa-solid fa-arrow-down"></i></a>{{/if}}
      </div>{{/if}}
      <div class="tt-stat" title="{{localize 'TAGANDTALLY.Spell.MaiLong'}}"><i class="fa-solid fa-wand-sparkles"></i> MAI {{mai.total}}</div>
      <div class="tt-stat" title="{{localize 'TAGANDTALLY.Gear.Loadout'}}"><i class="fa-solid fa-suitcase"></i> {{loadout.value}}/{{loadout.max}}</div>
    </div>
  </div>
</header>
