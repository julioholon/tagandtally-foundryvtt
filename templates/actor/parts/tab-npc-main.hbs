<section class="tab {{tab.cssClass}} tt-npc-main" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="tt-grid two">
    {{#if system.creature}}
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.Disposition"}}</label>{{#if canSee.disposition}}<div class="tt-with-reroll"><input type="text" name="system.sentence.disposition" value="{{system.sentence.disposition}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.disposition" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "disposition"))}}<a class="tt-reveal" data-action="reveal" data-key="disposition" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "disposition")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.TagType.Descriptor"}}</label>{{#if canSee.descriptor}}<div class="tt-with-reroll"><input type="text" name="system.sentence.descriptor" value="{{system.sentence.descriptor}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.descriptor" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "descriptor"))}}<a class="tt-reveal" data-action="reveal" data-key="descriptor" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "descriptor")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.CreatureType"}}</label>{{#if canSee.type}}<div class="tt-with-reroll"><input type="text" name="system.sentence.type" value="{{system.sentence.type}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.type" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "type"))}}<a class="tt-reveal" data-action="reveal" data-key="type" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "type")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.Motivation"}}</label>{{#if canSee.motivation}}<div class="tt-with-reroll"><input type="text" name="system.sentence.motivation" value="{{system.sentence.motivation}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.motivation" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "motivation"))}}<a class="tt-reveal" data-action="reveal" data-key="motivation" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "motivation")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.Attack"}}</label>{{#if canSee.attack}}<div class="tt-with-reroll"><input type="text" name="system.sentence.attack" value="{{system.sentence.attack}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.attack" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "attack"))}}<a class="tt-reveal" data-action="reveal" data-key="attack" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "attack")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Damage.Type"}}</label>{{#if canSee.damageType}}<div class="tt-with-reroll"><input type="text" name="system.sentence.damageType" value="{{system.sentence.damageType}}" list="tt-damage-types" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.damageType" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "damageType"))}}<a class="tt-reveal" data-action="reveal" data-key="damageType" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "damageType")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group span2"><label>{{localize "TAGANDTALLY.Npc.SpecialAbility"}}</label>{{#if canSee.specialAbility}}<div class="tt-with-reroll"><input type="text" name="system.sentence.specialAbility" value="{{system.sentence.specialAbility}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.specialAbility" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "specialAbility"))}}<a class="tt-reveal" data-action="reveal" data-key="specialAbility" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "specialAbility")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <datalist id="tt-damage-types">{{#each damageTypes as |label key|}}<option value="{{localize label}}"></option>{{/each}}</datalist>
    {{else}}
      <div class="form-group"><label>{{localize "TAGANDTALLY.TagType.Descriptor"}}</label>{{#if canSee.descriptor}}<div class="tt-with-reroll"><input type="text" name="system.sentence.descriptor" value="{{system.sentence.descriptor}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.descriptor" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "descriptor"))}}<a class="tt-reveal" data-action="reveal" data-key="descriptor" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "descriptor")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.TagType.Species"}}</label>{{#if canSee.species}}<div class="tt-with-reroll"><input type="text" name="system.sentence.species" value="{{system.sentence.species}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.species" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "species"))}}<a class="tt-reveal" data-action="reveal" data-key="species" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "species")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.TagType.Type"}}</label>{{#if canSee.type}}<div class="tt-with-reroll"><input type="text" name="system.sentence.type" value="{{system.sentence.type}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.type" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "type"))}}<a class="tt-reveal" data-action="reveal" data-key="type" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "type")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.DoesSomething"}}</label>{{#if canSee.doesSomething}}<div class="tt-with-reroll"><input type="text" name="system.sentence.doesSomething" value="{{system.sentence.doesSomething}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.doesSomething" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "doesSomething"))}}<a class="tt-reveal" data-action="reveal" data-key="doesSomething" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "doesSomething")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.Motivation"}}</label>{{#if canSee.motivation}}<div class="tt-with-reroll"><input type="text" name="system.sentence.motivation" value="{{system.sentence.motivation}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.motivation" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "motivation"))}}<a class="tt-reveal" data-action="reveal" data-key="motivation" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "motivation")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.Quest"}}</label>{{#if canSee.quest}}<div class="tt-with-reroll"><input type="text" name="system.sentence.quest" value="{{system.sentence.quest}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.quest" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "quest"))}}<a class="tt-reveal" data-action="reveal" data-key="quest" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "quest")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Npc.Attack"}}</label>{{#if canSee.attack}}<div class="tt-with-reroll"><input type="text" name="system.sentence.attack" value="{{system.sentence.attack}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.attack" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "attack"))}}<a class="tt-reveal" data-action="reveal" data-key="attack" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "attack")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Damage.Type"}}</label>{{#if canSee.damageType}}<div class="tt-with-reroll"><input type="text" name="system.sentence.damageType" value="{{system.sentence.damageType}}" />{{#if owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.damageType" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>{{else}}<span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>{{/if}}{{#if (tt-and isGM (tt-includes hiddenKeys "damageType"))}}<a class="tt-reveal" data-action="reveal" data-key="damageType" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup revealed "damageType")}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>{{/if}}</div>
    {{/if}}
  </div>

  <fieldset class="tt-hidden-info">
    <legend>{{localize "TAGANDTALLY.Npc.HiddenInfo"}}</legend>
    {{#each insightKeys as |key|}}
      <div class="tt-hidden-row">
        <label>{{localize (concat "TAGANDTALLY.Npc." key)}}</label>
        {{#if (lookup ../canSee key)}}
          <div class="tt-with-reroll"><input type="text" name="system.sentence.{{key}}" value="{{lookup ../system.sentence key}}" {{#unless ../owner}}disabled{{/unless}} />{{#if ../owner}}<a class="tt-reroll" data-action="rerollField" data-field="system.sentence.{{key}}" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div>
        {{else}}
          <span class="tt-secret"><i class="fa-solid fa-eye-slash"></i> {{localize "TAGANDTALLY.Npc.Unknown"}}</span>
        {{/if}}
        {{#if ../isGM}}
          <a data-action="reveal" data-key="{{key}}" title="{{localize 'TAGANDTALLY.Npc.ToggleReveal'}}"><i class="fa-solid {{#if (lookup ../revealed key)}}fa-eye{{else}}fa-eye-slash{{/if}}"></i></a>
        {{/if}}
        {{#if (lookup ../insightBoxes key)}}
          <span class="tt-boxes small" title="{{localize 'TAGANDTALLY.Npc.Insights'}}">
            {{#each (lookup ../insightBoxes key) as |filled i|}}<a class="tt-box {{#if filled}}filled{{/if}}" data-action="addInsight" data-key="{{key}}" data-index="{{i}}"></a>{{/each}}
          </span>
        {{/if}}
      </div>
    {{/each}}
  </fieldset>

  <div class="tt-actions-row">
    <button type="button" data-action="rollInjury"><i class="fa-solid fa-heart-crack"></i> {{localize "TAGANDTALLY.Combat.RollInjury"}}</button>
    <button type="button" data-action="openCombatFlow"><i class="fa-solid fa-swords"></i> {{localize "TAGANDTALLY.Combat.Title"}}</button>
    {{#unless system.creature}}<button type="button" data-action="interact"><i class="fa-solid fa-comments"></i> {{localize "TAGANDTALLY.Interaction.Interact"}}</button>{{/unless}}
    <button type="button" data-action="openBarter"><i class="fa-solid fa-scale-balanced"></i> {{localize "TAGANDTALLY.Barter.Title"}}</button>
    <label class="tt-toggle"><input type="checkbox" name="system.merchant" {{checked system.merchant}} /> {{localize "TAGANDTALLY.Npc.Merchant"}}</label>
    <div class="tt-stat" title="{{localize 'TAGANDTALLY.Wealth.Wealth'}}"><i class="fa-solid fa-coins"></i> <input type="number" name="system.wealth.value" value="{{system.wealth.value}}" min="0" max="6" class="tt-small-num" />{{#if coinsMode}} <small>{{localize "TAGANDTALLY.Coins.Coins"}}</small> <input type="number" name="system.wealth.coins" value="{{system.wealth.coins}}" min="0" class="tt-small-num wide" />{{/if}}</div>
  </div>
</section>
