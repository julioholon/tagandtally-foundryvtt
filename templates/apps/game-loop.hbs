<div class="tt-loop">
  <div class="tt-toolbar">
    <span class="tt-day"><i class="fa-solid fa-calendar-day"></i> {{localize "TAGANDTALLY.Downtime.Day" day=day}}</span>
    <span class="tt-scene-no"><i class="fa-solid fa-clapperboard"></i> {{localize "TAGANDTALLY.Loop.SceneNumber" number=scene.number}}</span>
    <span class="tt-controls">
      <button type="button" data-action="addParty"><i class="fa-solid fa-people-group"></i> {{localize "TAGANDTALLY.Downtime.AddParty"}}</button>
      <button type="button" data-action="addSelected"><i class="fa-solid fa-plus"></i> {{localize "TAGANDTALLY.Combat.AddSelected"}}</button>
      <button type="button" data-action="openChronicle" title="{{localize 'TAGANDTALLY.Loop.ChronicleHint'}}"><i class="fa-solid fa-book"></i> {{localize "TAGANDTALLY.Loop.Chronicle"}}</button>
    </span>
  </div>
  <p class="hint">{{localize "TAGANDTALLY.Loop.Hint"}}</p>

  <section class="tt-loop-scene">
    {{#if hasScene}}
      <p class="tt-loop-sentence"><em>{{scene.sentence}}</em>{{#if isGM}} <a data-action="reroll" data-field="sentence" title="{{localize 'TAGANDTALLY.Travel.Reroll'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</p>
      <div class="tt-loop-facts">
        <span><strong>{{localize "TAGANDTALLY.Level.Level"}}</strong> {{scene.level}} · {{levelLabel}} <small class="dim">({{scene.levelDetail}})</small>{{#if isGM}} <a data-action="reroll" data-field="level" title="{{localize 'TAGANDTALLY.Travel.Reroll'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}{{#if canApplyLevel}} <a data-action="applyLevel" title="{{localize 'TAGANDTALLY.Travel.ApplyLevelHint'}}"><i class="fa-solid fa-arrow-right-to-bracket"></i> {{localize "TAGANDTALLY.Travel.ApplyLevel"}}</a>{{/if}}</span>
        {{#each (tt-array "timeOfDay" "weather" "season") as |m|}}<span><strong>{{localize (concat "TAGANDTALLY.Loop.Modifier." m)}}</strong> {{#if (lookup ../scene.modifiers m)}}{{lookup ../scene.modifiers m}}{{else}}—{{/if}}{{#if ../isGM}} <a data-action="reroll" data-field="{{m}}" title="{{localize 'TAGANDTALLY.Travel.Reroll'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</span>{{/each}}
      </div>
    {{else}}
      <p class="tt-empty">{{localize "TAGANDTALLY.Loop.NoScene"}} {{#if isGM}}<button type="button" class="tt-roll-btn" data-action="rollScene"><i class="fa-solid fa-dice"></i> {{localize "TAGANDTALLY.Loop.RollScene"}}</button>{{/if}}</p>
    {{/if}}
    <div class="tt-grid two">
      <div class="form-group"><label>{{localize "TAGANDTALLY.Loop.Scope"}} <small class="hint">{{localize "TAGANDTALLY.Loop.ScopeHint"}}</small></label>
        <select name="scope">{{#each scopes as |s|}}<option value="{{s.id}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>{{/each}}</select></div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Quest.Quest"}}</label>
        <select name="questUuid"><option value="">{{localize "TAGANDTALLY.Loop.NoQuest"}}</option>{{#each quests as |q|}}<option value="{{q.uuid}}" {{#if q.selected}}selected{{/if}}>{{q.name}}</option>{{/each}}</select></div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Loop.Intent"}}</label><textarea name="intent" rows="2" placeholder="{{localize 'TAGANDTALLY.Loop.IntentPlaceholder'}}">{{scene.intent}}</textarea></div>
      <div class="form-group"><label>{{localize "TAGANDTALLY.Loop.Stakes"}}</label><textarea name="stakes" rows="2" placeholder="{{localize 'TAGANDTALLY.Loop.StakesPlaceholder'}}">{{scene.stakes}}</textarea></div>
    </div>
  </section>

  <ol class="tt-loop-list">
    {{#each participants as |p|}}
      <li class="tt-loop-row {{#if p.ready}}ready{{/if}}" data-uuid="{{p.uuid}}">
        <header>
          <img src="{{p.img}}" alt="" />
          <strong>{{p.name}}</strong>
          <span class="tt-boxes" title="{{localize 'TAGANDTALLY.Loop.Actions'}}">{{#each p.pips as |filled|}}<span class="tt-box {{#if filled}}filled{{/if}}"></span>{{/each}}</span>
          <span class="tt-controls">
            {{#if p.canAct}}<button type="button" class="tt-ready {{#if p.ready}}on{{/if}}" data-action="ready"><i class="fa-solid {{#if p.ready}}fa-circle-check{{else}}fa-circle{{/if}}"></i> {{localize "TAGANDTALLY.Loop.Ready"}}</button>{{else}}<span class="tt-ready-state"><i class="fa-solid {{#if p.ready}}fa-circle-check{{else}}fa-circle{{/if}}"></i> {{localize (tt-ternary p.ready "TAGANDTALLY.Loop.Ready" "TAGANDTALLY.Loop.NotReadyYet")}}</span>{{/if}}
            {{#if ../isGM}}<a data-action="remove" data-uuid="{{p.uuid}}" title="{{localize 'TAGANDTALLY.Relations.Remove'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
          </span>
        </header>
        {{#if p.canAct}}
        <div class="tt-loop-actions">
          {{#each p.actions as |a|}}<button type="button" data-action="act" data-act="{{a.id}}" title="{{a.hint}}" {{#if a.disabled}}disabled{{/if}}><i class="fa-solid {{a.icon}}"></i> {{a.label}}</button>{{/each}}
        </div>
        {{/if}}
      </li>
    {{/each}}
    {{#unless participants.length}}<li class="tt-empty">{{localize "TAGANDTALLY.Loop.NoParticipants"}}</li>{{/unless}}
  </ol>

  <div class="tt-loop-advance">
    <span class="hint">{{#if allReady}}{{localize "TAGANDTALLY.Loop.AllReady"}}{{else}}{{localize "TAGANDTALLY.Loop.WaitingReady"}}{{/if}}</span>
    <span class="tt-controls">
      {{#if isGM}}<a data-action="resetActions" title="{{localize 'TAGANDTALLY.Loop.ResetActionsHint'}}"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}
      <button type="button" class="tt-roll-btn" data-action="advance" {{#unless canAdvance}}disabled{{/unless}}><i class="fa-solid fa-forward"></i> {{localize "TAGANDTALLY.Loop.Advance"}} <small>({{localize scopeDef.label}})</small></button>
    </span>
  </div>

  {{#if log.length}}
    <ol class="tt-loop-log">
      {{#each log as |l|}}<li><i class="fa-solid {{l.icon}}"></i> {{#if l.actor}}<strong>{{l.actor}}</strong> {{/if}}{{l.text}}</li>{{/each}}
    </ol>
    {{#if isGM}}<a class="tt-clear-log" data-action="clearLog"><i class="fa-solid fa-trash"></i> {{localize "TAGANDTALLY.Travel.ClearLog"}}</a>{{/if}}
  {{/if}}
  {{#if history.length}}
    <details class="tt-loop-history"><summary>{{localize "TAGANDTALLY.Loop.History"}}</summary>
      <ol>{{#each history as |h|}}<li><small class="dim">{{localize "TAGANDTALLY.Loop.SceneNumber" number=h.number}} · {{localize "TAGANDTALLY.Downtime.Day" day=h.day}}</small> {{h.sentence}}{{#if h.intent}} — <em>{{h.intent}}</em>{{/if}}</li>{{/each}}</ol>
    </details>
  {{/if}}
</div>
