<div class="tt-travel">
  <div class="tt-toolbar">
    <span class="tt-segments">
      {{#each modes as |m|}}<a class="tt-segment {{#if m.active}}on{{/if}} {{#unless ../isGM}}readonly{{/unless}}" data-action="setMode" data-mode="{{m.id}}"><i class="fa-solid {{m.icon}}"></i> {{m.label}}</a>{{/each}}
    </span>
  </div>
  <p class="hint">{{hint}}</p>

  <div class="tt-travel-actions">
    <button type="button" class="tt-roll-btn" data-action="explore"><i class="fa-solid fa-dice"></i> {{exploreLabel}}</button>
    {{#if hasHex}}
      <button type="button" data-action="postHex" title="{{localize 'TAGANDTALLY.Travel.PostHint'}}"><i class="fa-solid fa-comment"></i> {{localize "TAGANDTALLY.Travel.Post"}}</button>
      {{#if canApplyLevel}}<button type="button" data-action="applyLevel" title="{{localize 'TAGANDTALLY.Travel.ApplyLevelHint'}}"><i class="fa-solid fa-arrow-right-to-bracket"></i> {{localize "TAGANDTALLY.Travel.ApplyLevel"}}</button>{{/if}}
      {{#if isGM}}<a class="tt-clear-hex" data-action="clearHex" title="{{localize 'TAGANDTALLY.Travel.ClearHex'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    {{/if}}
  </div>

  {{#if hasHex}}
    <ul class="tt-hex-fields">
      {{#each fields as |f|}}
        <li class="{{#if f.empty}}empty{{/if}}">
          <i class="fa-solid {{f.icon}}"></i>
          <strong>{{f.label}}</strong>
          <span class="tt-hex-value">{{#if f.empty}}<em>—</em>{{else}}{{f.value}}{{/if}}{{#if f.detail}} <small class="dim">({{f.detail}})</small>{{/if}}</span>
          <a data-action="reroll" data-field="{{f.key}}" title="{{localize 'TAGANDTALLY.Travel.Reroll'}}"><i class="fa-solid fa-dice"></i></a>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="tt-empty">{{localize "TAGANDTALLY.Travel.NoHex"}}</p>
  {{/if}}

  <div class="tt-travel-rest">
    <span class="hint">{{localize "TAGANDTALLY.Travel.RestHint" party=party watchers=watchers}} {{localize (tt-ternary safeZone "TAGANDTALLY.Downtime.SafeZone" "TAGANDTALLY.Downtime.Camp")}}.</span>
    <span class="tt-controls">
      <button type="button" data-action="openDowntime"><i class="fa-solid fa-bed"></i> {{localize "TAGANDTALLY.Downtime.Title"}}</button>
      {{#if isGM}}
        <button type="button" data-action="rest"><i class="fa-solid fa-moon"></i> {{localize "TAGANDTALLY.Travel.Rest"}}</button>
        <button type="button" data-action="newDay" title="{{localize 'TAGANDTALLY.Downtime.NewDayHint'}}"><i class="fa-solid fa-sun"></i> {{localize "TAGANDTALLY.Downtime.NewDay"}}</button>
      {{/if}}
    </span>
  </div>

  {{#if log.length}}
    <ol class="tt-travel-log">
      {{#each log as |l|}}<li><i class="fa-solid {{l.icon}}"></i> {{l.text}}</li>{{/each}}
    </ol>
    {{#if isGM}}<a class="tt-clear-log" data-action="clearLog"><i class="fa-solid fa-trash"></i> {{localize "TAGANDTALLY.Travel.ClearLog"}}</a>{{/if}}
  {{/if}}
</div>
