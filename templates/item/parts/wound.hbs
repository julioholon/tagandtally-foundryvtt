<section class="tab {{tab.cssClass}} tt-grid two" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="form-group"><label>{{localize "TAGANDTALLY.Wound.Track"}}</label><select name="system.injuryType">{{selectOptions tracks selected=system.injuryType localize=true}}</select></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Damage.Type"}}</label><div class="tt-with-reroll"><input type="text" name="system.damageType" value="{{system.damageType}}" list="tt-dmg" />{{#if item.isOwner}}<a class="tt-reroll" data-action="rerollField" data-field="system.damageType" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div><datalist id="tt-dmg">{{#each damageTypes as |l k|}}<option value="{{localize l}}"></option>{{/each}}</datalist></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.TagType.Descriptor"}}</label><div class="tt-with-reroll"><input type="text" name="system.descriptor" value="{{system.descriptor}}" />{{#if item.isOwner}}<a class="tt-reroll" data-action="rerollField" data-field="system.descriptor" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Wound.Mark"}}</label><div class="tt-with-reroll"><input type="text" name="system.mark" value="{{system.mark}}" />{{#if item.isOwner}}<a class="tt-reroll" data-action="rerollField" data-field="system.mark" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Wound.BodyPart"}}</label><div class="tt-with-reroll"><input type="text" name="system.bodyPart" value="{{system.bodyPart}}" />{{#if item.isOwner}}<a class="tt-reroll" data-action="rerollField" data-field="system.bodyPart" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Wound.Hinders"}}</label><div class="tt-with-reroll"><input type="text" name="system.hinders" value="{{system.hinders}}" />{{#if item.isOwner}}<a class="tt-reroll" data-action="rerollField" data-field="system.hinders" title="{{localize 'TAGANDTALLY.Reroll.Field'}}"><i class="fa-solid fa-dice"></i></a>{{/if}}</div></div>
  <div class="form-group"><label class="tt-toggle"><input type="checkbox" name="system.healed" {{checked system.healed}} /> {{localize "TAGANDTALLY.Wound.Healed"}}</label></div>
  <div class="form-group">{{#if isGM}}<a data-action="generateSentence"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "TAGANDTALLY.Sparks.Regenerate"}}</a>{{/if}}</div>
</section>
