<section class="tab {{tab.cssClass}} tt-grid two" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="form-group"><label>{{localize "TAGANDTALLY.Gear.Type"}}</label><select name="system.gearType">{{selectOptions config.gearTypes selected=system.gearType localize=true}}</select></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.GearKind.Kind"}}</label><select name="system.kind">{{selectOptions config.gearKinds selected=system.kind localize=true}}</select></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Level.Level"}}</label><select name="system.level">{{selectOptions config.gearLevels selected=system.level localize=true}}</select></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Cost.Cost"}}</label><select name="system.cost">{{selectOptions config.costLevels selected=system.cost localize=true}}</select></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Gear.Qty"}}</label><input type="number" name="system.quantity" value="{{system.quantity}}" min="0" /></div>
  <div class="form-group"><label class="tt-toggle"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "TAGANDTALLY.Gear.Equipped"}}</label></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.TagType.Descriptor"}}</label><input type="text" name="system.descriptor" value="{{system.descriptor}}" /></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Gear.Material"}}</label><input type="text" name="system.material" value="{{system.material}}" /></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Gear.Subtype"}}</label><input type="text" name="system.subtype" value="{{system.subtype}}" /></div>
  <div class="form-group"><label>{{localize "TAGANDTALLY.Gear.Special"}}</label><input type="text" name="system.special" value="{{system.special}}" /></div>
  {{#if system.isWeapon}}<div class="form-group"><label>{{localize "TAGANDTALLY.Damage.Type"}}</label><input type="text" name="system.damageType" value="{{system.damageType}}" /></div>{{/if}}
  {{#if system.isArmor}}<div class="form-group"><label>{{localize "TAGANDTALLY.Armor.Class"}}</label><select name="system.armorClass">{{selectOptions armorClasses selected=system.armorClass localize=true}}</select>
    <small>{{localize "TAGANDTALLY.Armor.Defense"}} +{{system.armor.defense}} · {{localize "TAGANDTALLY.Armor.Stealth"}} -{{system.armor.stealth}}</small></div>{{/if}}
  {{#if system.isConsumable}}<div class="form-group"><label>{{localize "TAGANDTALLY.Consumable.Mode"}}</label><select name="system.consumableMode">{{selectOptions config.consumableModes selected=system.consumableMode localize=true}}</select></div>{{/if}}
  {{#if system.isContainer}}<div class="form-group"><label>{{localize "TAGANDTALLY.Gear.Capacity"}}</label><input type="number" name="system.capacity" value="{{system.capacity}}" min="0" /></div>{{/if}}
  <div class="form-group"><label>{{localize "TAGANDTALLY.Rarity.Rarity"}}</label><select name="system.rarity">{{#each config.crafting.rarities as |r k|}}<option value="{{k}}" {{#if (tt-eq (tt-add k 0) ../system.rarity)}}selected{{/if}}>{{localize r.label}}</option>{{/each}}</select></div>
  <div class="form-group"><label class="tt-toggle"><input type="checkbox" name="system.broken" {{checked system.broken}} /> {{localize "TAGANDTALLY.Gear.Broken"}}</label>{{#if system.isResource}}<label class="tt-toggle"><input type="checkbox" name="system.salvaged" {{checked system.salvaged}} /> {{localize "TAGANDTALLY.Gear.Salvaged"}}</label>{{/if}}</div>
  {{#if system.augmentations.length}}<div class="form-group span2"><label>{{localize "TAGANDTALLY.Gear.Augmentations"}} ({{system.augmentations.length}}/{{config.crafting.maxAugmentations}})</label>
    <ol class="tt-augmentations">{{#each system.augmentations as |a i|}}<li><input type="text" name="system.augmentations.{{i}}" value="{{a}}" /></li>{{/each}}</ol></div>{{/if}}
  <div class="form-group span2"><label>{{localize "TAGANDTALLY.Gear.CustomSentence"}}</label><input type="text" name="system.sentence" value="{{system.sentence}}" placeholder="{{system.sentenceText}}" />
    {{#if isGM}}<a data-action="generateSentence" title="{{localize 'TAGANDTALLY.Sparks.Regenerate'}}"><i class="fa-solid fa-wand-magic-sparkles"></i></a>{{/if}}</div>
</section>
